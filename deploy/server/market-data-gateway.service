[Unit]
Description=Market Data read-only gateway
Wants=network-online.target
After=network-online.target local-fs.target

[Service]
Type=simple
User=quant
Group=quant
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/market-data-api/gateway.env
ExecStart=/usr/bin/python3 /opt/market-data-api/mdapi-gateway.pyz --root ${MDAPI_DATA_ROOT} --host ${MDAPI_GATEWAY_HOST} --port ${MDAPI_GATEWAY_PORT} --max-streams ${MDAPI_MAX_STREAMS} --queue-timeout ${MDAPI_QUEUE_TIMEOUT} --token-file ${MDAPI_TOKEN_FILE}
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/cache/market-data-api

[Install]
WantedBy=multi-user.target
